rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }

    function isActiveUser() {
      return hasProfile() && userData().isActive == true;
    }

    function isAdmin() {
      return isActiveUser() && userData().role == 'admin';
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /cars/{carId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /carBrands/{brandId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /carModels/{modelId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }
  }
}
